{
  "name": "dvr-installer",
  "productName": "DioramaVR",
  "version": "0.4.2",
  "description": "Installs the free DioramaVR tabletop VR mods for Steam games",
  "author": "scrire",
  "license": "MIT",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "build-mods": "node scripts/build-mods.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.dioramavr.installer",
    "productName": "DioramaVR",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "engine/**",
      "cli.js",
      "package.json",
      "LICENSE",
      "credits.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "DioramaVR-${version}.exe"
    }
  },
  "devDependencies": {
    "@fontsource/castoro": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "dvr-package": "git+https://github.com/DioramaVR/dvr-package.git#v0.1.5"
  }
}
